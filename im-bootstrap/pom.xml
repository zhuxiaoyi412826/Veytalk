<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.im</groupId>
        <artifactId>im-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>im-bootstrap</artifactId>
    <name>im-bootstrap</name>
    <description>启动模块：聚合全部业务模块，打包为唯一可执行 jar（im-server.jar）</description>

    <dependencies>
        <dependency>
            <groupId>com.im</groupId>
            <artifactId>im-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.im</groupId>
            <artifactId>im-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.im</groupId>
            <artifactId>im-friend</artifactId>
        </dependency>
        <dependency>
            <groupId>com.im</groupId>
            <artifactId>im-conversation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.im</groupId>
            <artifactId>im-message</artifactId>
        </dependency>
        <dependency>
            <groupId>com.im</groupId>
            <artifactId>im-group</artifactId>
        </dependency>
        <dependency>
            <groupId>com.im</groupId>
            <artifactId>im-file</artifactId>
        </dependency>
        <dependency>
            <groupId>com.im</groupId>
            <artifactId>im-websocket</artifactId>
        </dependency>

        <!-- 运行期驱动，编译期不需要 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>im-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.im.bootstrap.ImApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
