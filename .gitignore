# ==============================================================================
# 构建产物
# ==============================================================================
target/
!.mvn/wrapper/maven-wrapper.jar
build/
out/
*.jar
*.war
*.ear
*.dll
*.so
*.dylib
*.pak
*.exe
*.txt
# 打包产物需要发布时单独用 git add -f，不靠忽略规则例外放行

# ==============================================================================
# 前端
# ==============================================================================
node_modules/
im-ui/dist/
im-ui/dist-ssr/
.npm/
.pnpm-store/
*.local
.vite/

# 图片审核的可投放资产：体积上百 MB，不进仓库，由运维按 md/图片内容审核接入指南.md 放好。
# 前端对它存在与否做了降级（模型不在就停用那个检测器），仓库不投放不影响构建。
# 只模型不入库：血腥 / 暴力那个 ONNX 的推理运行时（onnxruntime-web 的 wasm）走 npm 依赖
# 随构建产出，不必再拷到 public 下。
# 注意 public/tesseract、public/tessdata（OCR 离线包约 32MB）是要提交的，不在这里。
im-ui/public/models/

# Electron 桌面端：只忽略构建产物 / 依赖 / 大二进制，源码要提交
# 保留提交：main.js、preload.js、package.json、package-lock.json、bin/ffmpeg放置说明.txt
# （node_modules、ffmpeg.exe 其实已被全局规则 node_modules/、*.exe 覆盖，这里显式列出更直观）
electron/node_modules/
electron/dist/
electron/release/
electron/bin/ffmpeg.exe
# 本机直播自测：live-media-server.js 的 HLS 落盘目录（媒体分片，不进版本库）
electron/live-data/

# ==============================================================================
# 运行时产生的文件
# ==============================================================================
logs/
*.log
# 本地文件存储模式的上传目录（默认在 ${user.home}/im-files，不在仓库内；
# 若把 IM_FILE_DIR 指到了项目里，这里兜住）
im-files/

# ==============================================================================
# 环境与密钥
# 凭据只从环境变量读取，任何 .env 都不应进版本库
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
# 开发期自签 HTTPS 证书目录（im-ui/scripts/gen-cert.cjs 生成，含私钥）
im-ui/certs/

# ==============================================================================
# IDE / 编辑器
# ==============================================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.settings/
.classpath
.project
.factorypath
*.swp
*.swo
*~

# ==============================================================================
# 操作系统
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ==============================================================================
# 临时调试产物
# 接口串测时很容易在根目录落下一堆 json / token 快照，统一忽略掉
# ==============================================================================
_probe/
tmp/
temp/
*.tmp
*.bak
*.orig
