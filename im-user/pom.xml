<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.im</groupId>
        <artifactId>im-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>im-user</artifactId>
    <name>im-user</name>
    <description>用户中心：注册登录、验证码、资料、在线状态、角色权限</description>

    <dependencies>
        <!-- 业务模块只依赖 im-common，跨模块协作全部走 com.im.common.spi 契约 -->
        <dependency>
            <groupId>com.im</groupId>
            <artifactId>im-common</artifactId>
        </dependency>

        <!-- 邮箱验证码登录：通过 QQ 邮箱 SMTP 发送验证码邮件 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
    </dependencies>
</project>
