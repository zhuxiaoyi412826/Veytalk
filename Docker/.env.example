# ==============================================================================
# compose 层的环境变量（docker compose 自己读，不是给 java 进程读的）
#
# ★ 与 conf/im.env 的分工别搞混（Docker部署指南.md 第三节）：
#   .env          → 编排参数：镜像 tag、密码、域名。compose 在启动时插值进 docker-compose.yml
#   conf/im.env   → 应用配置：application.yml 里那 60 个 ${} 占位符。由 env_file 注入 java 进程
# 两份里同一个值（三份密码、MinIO 凭据）必须逐字一致，不一致的表现是「容器都起来了但连不上」。
#
# 用法：cp .env.example .env && chmod 600 .env && 把下面所有 <...> 换成真值
# 本文件进版本库，.env 不进（.gitignore 里 .env 已忽略、.env.example 例外放行）。
# ==============================================================================

# ---------- 镜像版本：写死而不是 latest ----------
# 全靠它保证「同一份 compose 在两台机器上跑出同一结果」和「回滚有目标」
MYSQL_TAG=8.0
REDIS_TAG=7-alpine
NGINX_TAG=1.27-alpine
NODE_TAG=22-alpine
MINIO_TAG=RELEASE.2025-04-22T22-12-26Z

# ---------- 依赖镜像来源 ----------
# ★ 本地测试默认直连 Docker Hub 官方短名（能上外网就最快，无需 GHCR/登录）。
#   生产环境（国内服务器拉 Docker Hub 慢/失败时）切回 CI 的 mirror-images 同步到 GHCR 的镜像站，
#   把下面三行改回：ghcr.io/<owner小写>/im-deps/mysql|redis|nginx
#   （<owner小写> 由 bootstrap.sh 从 IM_SERVER_TAG 里的同一个 owner 自动回填，不用手改）
MYSQL_IMAGE=mysql
REDIS_IMAGE=redis
NGINX_IMAGE=nginx

# ---------- minio：不走 CI/GHCR，单独部署（见 minio/docker-compose.yml）----------
# ★ minio 已从 mirror-images 的同步矩阵里摘掉：MinIO 于 2026-09-11 把 minio/minio 从 Docker Hub 整仓
#   删除（404/denied），quay.io/minio/minio 又拒 GitHub runner 共享 IP 的匿名拉（401），流水线搬不动它。
#   因此 minio 不属主栈。★ 首选直接用官方二进制跑（下 https://dl.min.io/server/minio/release/linux-amd64/minio
#   + systemd，不依赖镜像仓库，见 md/MinIO部署指南.md 三/四节）；下面的 MINIO_IMAGE 只在走“容器退路”（minio/docker-compose.yml）时才用。
#   容器退路的默认源是 quay.io（此值不参与 bootstrap.sh 的 owner 回填，无需 <owner小写>）：
MINIO_IMAGE=quay.io/minio/minio
#   走容器退路时若连 quay 也被限流/要登录，先 `docker login quay.io`（免费账号即可抬高匿名限流）。

# 后端镜像：直接用 GitHub Actions 构建并推上 GHCR 的产物，本地不跑 mvn
# ★ CI（.github/workflows/build-and-package.yml）在 push 到 main 时会自动 mvn 打 jar → build 镜像 →
#   推 ghcr.io/zhuxiaoyi412826/im-server:1.0.0（owner 取本仓库、已全小写；tag 取根 pom 的 1.0.0）。
#   所以本机 docker compose up 只是【拉现成镜像】，不需要本地准备 jar。前提：
#     ① 这条 main 上至少成功跑过一次 CI（镜像得先在 GHCR 里）；
#     ② 若仓库/包是私有，目标机要先 docker login ghcr.io（PAT 只读 read:packages）；公开包则免登录。
#   （想脱离 CI 纯本地构建时才用：IM_SERVER_TAG=local/im-server:1.0.0，那样得自己 mvn package 并把 jar 放 Docker/app/）
IM_SERVER_TAG=ghcr.io/zhuxiaoyi412826/im-server:1.0.0

# ---------- 域名（四个 server_name、证书路径、CORS 白名单都由 bootstrap.sh 从这里的值灌进生成物） ----------
# ★ 这四个值必须与你自己签发的证书 CN/SAN 一致，不一致就是「浏览器报 NET::ERR_CERT_COMMON_NAME_INVALID」
IM_DOMAIN=im.example.com
ADMIN_DOMAIN=admin.example.com
WEBSITE_DOMAIN=www.example.com
LIVE_DOMAIN=live.example.com

# ---------- ★ 凭据：不要复用、不要留空、不要提交 ----------
# 生成一条：openssl rand -base64 24 | tr -d '=+/' | head -c 24
MYSQL_ROOT_PASSWORD=zhuxiaoyi
# 业务账号 im 的密码，bootstrap.sh 会把它同步进 conf/im.env
MYSQL_PASSWORD=412826zxyZXY
# 必须与 conf/im.env 的 REDIS_PASSWORD 一致
REDIS_PASSWORD=412826zxyZXY
# MinIO：USER ≥3 字符、PASSWORD ≥8 字符。★ 本地测试用默认 minioadmin/minioadmin（与 conf/im.env 的
#   MINIO_ACCESS_KEY/SECRET_KEY 由 bootstrap.sh 自动同步一致）；正式上服务器务必换成强凭据，别把 minioadmin 传到公网。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Sa-Token JWT 与 WS/文件票据签名密钥：bootstrap.sh 写进 conf/im.env（这两串泄露等于任何人能自签 token）
# ★ 下面是本地测试的 dev 默认值；生产环境务必各换成 ≥32 位随机串：openssl rand -base64 24 | tr -d '=+/' | head -c 32
IM_JWT_SECRET=dev-only-jwt-secret-DO-NOT-USE-IN-PROD-8f3a1c7d
IM_TICKET_SECRET=dev-only-ticket-secret-DO-NOT-USE-IN-PROD-2b9e4f6a
# ★ 直播回放签名密钥：bootstrap.sh 会把它同时灌进 conf/im.env 的 IM_LIVE_SIGN_SECRET
#   与 nginx im.conf 的 secure_link_md5 —— 就是因为两边容易写歪才收在这儿只填一次
LIVE_SIGN_SECRET=<开直播才需要，≥16位随机>

# ---------- 仅放开 coturn 那段时才用得到 ----------
# 与 conf/im.env 的 IM_TURN_SECRET 逐字一致，否则 TURN 客户端一律 401
TURN_SECRET=<只在开 TURN 时需要>
