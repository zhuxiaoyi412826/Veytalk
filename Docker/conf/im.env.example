# ==============================================================================
# 应用层环境变量：由 docker-compose.yml 的 env_file 注入 im-server 容器里的 java 进程，
# 对应 im-bootstrap/src/main/resources/application.yml 里那 60 个 ${ENV:默认值} 占位符。
#
# ★ 三条写这个文件的规矩（Docker部署指南.md 3.3，都是踩过的坑）：
#   ① 值不要加引号、不要写行内注释、不要指望 ${} 展开。
#      `IM_FILE_DIR=/app/files   # 注释` 会把「   # 注释」一起当成值传进进程，
#      路径类变量于是指向一个不存在的目录，而 Java 只报「找不到路径」不报「配置读错」。
#   ② 容器里的 127.0.0.1 指的是「它自己」：栈内中间件 MYSQL_HOST / REDIS_HOST 必须是服务名；
#      minio 已移出本栈，走 host.docker.internal（见下面 MINIO_ENDPOINT），同样不能写 127.0.0.1。
#   ③ 写完用 `docker compose exec im-server env | grep -E 'IM_|MYSQL_|REDIS_|MINIO_'` 复核真值。
#
# 用法：cp conf/im.env.example conf/im.env && chmod 600 conf/im.env && 把所有 <...> 换成真值
# （scripts/bootstrap.sh 会拒绝启动还留着 <...> 占位符的文件）
# ==============================================================================

# ===== 必填 =====
# dev profile 会在响应里回显验证码明文
SPRING_PROFILES_ACTIVE=prod
# ★ 裸机是 127.0.0.1，容器里必须是服务名（compose 网络内的 DNS 名）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=im_db
MYSQL_USER=im
# 与 .env 的 MYSQL_PASSWORD 逐字一致
MYSQL_PASSWORD=412826zxyZXY
# ★ 同上，必须是服务名
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=412826zxyZXY
REDIS_DATABASE=0
# Sa-Token JWT 签名密钥：换掉内置那串 dev-only 默认值，否则任何人能自签 token
IM_JWT_SECRET=dev-only-jwt-secret-DO-NOT-USE-IN-PROD-8f3a1c7d
# WS 连接票据 / 文件访问票据签名密钥，同上
IM_TICKET_SECRET=dev-only-ticket-secret-DO-NOT-USE-IN-PROD-2b9e4f6a
# ★ 默认 D:/rizi1/IM（Windows 路径）。Linux 上不改不会报错，只会「日志静默丢失」——logback 不拦启动
IM_LOG_HOME=/app/logs
# ★ 默认 ${user.home}/im-upload-tmp，不在卷上就会被重建容器时清掉（大文件合并前分片落在这儿）
IM_UPLOAD_TMP_DIR=/app/upload-tmp
# 与 MySQL 容器的 --default-time-zone=+08:00 一起设，两边只设一个就会出现两种时钟
TZ=Asia/Shanghai

# ===== 文件存储：装 MinIO（默认，推荐）=====
IM_FILE_STORAGE=minio
# ★ minio 已移出主栈、在部署机上单独起（见 minio/docker-compose.yml），发布在宿主 9000。
#   im-server 容器经 extra_hosts 的 host.docker.internal 解析到网桥网关 IP 连它，不再是栈内服务名 minio。
#   （裸机直跑仍是 http://127.0.0.1:9000；换回栈内跑 minio 才写 http://minio:9000。）
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=zhuxiaoyi
MINIO_SECRET_KEY=412826zxyZXY
# 桶名走 S3 规范：≥3 字符、只允许小写字母/数字/点/连字符。填 im 会被 SDK 拒绝并让后端启动失败
MINIO_BUCKET=im-files

# 不想跑 MinIO 就整段换成下面两行（少一个容器，代价是文件绑在这台机器的卷上）
# IM_FILE_STORAGE=local
# IM_FILE_DIR=/app/files

# ===== 按需（不设就留在开发默认值上，标 ★ 的那几条会「静默不可用」）=====
# ★ 默认 D:/资料/知识库/面试官：Linux 上这个路径不存在也不报错，只是检索永远空转
IM_AI_KNOWLEDGE_DIR=/app/knowledge
# 不设只有面试相关功能回「未配置」，其余照常
ALI_BABA_API_KEY=sk-ws-H.EXMXXPP.0xMG.MEYCIQDGsLRXm2R_3ia6oT5bXM-ZY4kgWl97EykHh3JALbgkngIhAPTWUqPduq-fW1bptFdua0ySyiuwJc9a2dYJlxnCWLPU
# ★ 默认 mock：只写日志、不发真短信，用户永远收不到验证码
# 目前代码里只有 mock 一个 SmsSender 实现，别填 aliyun / tencent：
# 那会让一个短信通道 bean 都装配不上，发码直接报「短信服务未配置」（应用仍能启动）
IM_SMS_PROVIDER=mock
MAIL_USERNAME=2927883590@qq.com
MAIL_PASSWORD=vhxtzmvmksqndgfh

# ===== 直播（不开直播就把 IM_LIVE_ENABLED 改成 false，其余行留着无害）=====
IM_LIVE_ENABLED=true
# ★ 两个 BASE_URL 必须写绝对地址。写相对值 /live 时，桌面端（页面从 file:// 加载）会由前端补成
#   https://<host>:8088，而 8088 是明文推流口、没有 TLS → 表现为「只有桌面端观众黑屏」。
#   PLAY 的最后一段必须与 nginx 的 location /live/ 同名；PUSH 绝不能写 http://nginx:8088/...
#   （那是容器内部 DNS，主播端在公网解析不到）。
IM_LIVE_PLAY_BASE_URL=https://im.dsaol.asia/live
IM_LIVE_PUSH_BASE_URL=http://120.78.126.132:8088/live
# ★ 别手改这行的值：bootstrap 会用根 .env 的 LIVE_SIGN_SECRET 覆盖它，
#   这样才能保证它与 nginx im.conf 里 secure_link_md5 的密钥逐字一致（不一致＝观众端一律 403 黑屏）。
IM_LIVE_SIGN_SECRET=effed6752c05e1e150ee3f21543f74f7cc25d5ca28cf427f
# ★ 必须与 compose 里 live-retention 服务的同名变量同一个数（不一致＝后台有回放入口、点进去 404）。
#   默认 1 天，别一上来改大：多档阶梯下一场 2 小时直播约 8~10GB。
IM_LIVE_REPLAY_RETENTION_DAYS=1

# ===== 通话 / TURN（只有公网跨 NAT 才需要，配合 coturn 那段 service）=====
IM_CALL_STUN_URLS=stun:120.78.126.132:3478
IM_CALL_TURN_ENABLED=true
IM_CALL_TURN_URLS=turn:120.78.126.132:3478?transport=udp
# 与 coturn 的 --static-auth-secret 逐字一致
IM_TURN_SECRET=95827de1a953192b10c47bbbf396adab

# ===== 微信小程序音视频通话（腾讯云 TRTC）——不开小程序通话就一行都不用动 =====
# 只有微信小程序走 TRTC；Web / 桌面 / 安卓走上面那套自建 WebRTC（STUN/TURN），两条链路并存、互不替代。
# 后端 GET /api/call/trtc-user-sig 拿下面两项现签 UserSig：SecretKey 只在服务端参与签名、绝不下发前端。
# ★ 保持 0 / 留空 = 未配置，这是降级不是错误：接口照常返回 sdkAppId=0 + 空签名，
#   小程序弹「通话服务未配置」并禁用通话入口，其余功能完全不受影响（不为它专门开一个应用也行）。
# 值在腾讯云 TRTC 控制台 → 应用管理 → SDKAppID 与「密钥」（一个账号可有多个应用，填小程序用的那个）。
# ★ 不要把值写成 <尖括号> 占位：bootstrap.sh 第④步会扫非注释行的 < > 并打 WARN（留 0 / 空才是正确姿势）。
# ★ 这两项 bootstrap.sh 不替你同步（根 .env 里没有对应键），只能手填；填完的生效方式见下面两行。
# ★ 改本文件这两行 → docker compose up -d --force-recreate im-server（env_file 只在创建容器时读入，restart 不重读）；
#   若是把字面值写进 app/extra/application-prod-extra.yml → docker compose restart im-server 就够（JVM 启动时读那份文件）。
IM_TRTC_SDK_APP_ID=0
IM_TRTC_SECRET_KEY=

# ===== 远控 UDP 打洞（默认关）=====
# 打开要同时做三件事：compose 里发布 "8947:8947/udp"、这里填公网 IP（不能写服务名）
IM_DIRECT_ENABLED=false
IM_DIRECT_PUNCH_HOST=120.78.126.132

# ===== 监控 =====
# ★ 容器里的 loopback 只有本容器能到：宿主机 curl localhost:8081 即使发布了端口也是拒的。
#   外部 Prometheus 要抓就改 0.0.0.0 并且仍然不发布端口（同 compose 网络内可抓，公网碰不到）
MANAGEMENT_ADDRESS=127.0.0.1
# 慢接口阈值（毫秒）：/api/** 端到端耗时超过它就写 SLOW-API/slow-api.log、进监控页「最近慢接口」（只留 200 条）、给 Prometheus 计数
# 设 0 或负数关掉慢接口拦截（actuator 指标不受影响）。★ 慢接口 / 慢 SQL / 审核命中这三档在 prod 下**不进 stdout**，`docker compose logs` 里看不到，只能读文件
# ★ 另一个旋钮不对称：慢 SQL 的 `im.log.slow-sql-millis`（默认 100）在 yml 里是字面量、没有 ${} 占位符，
#   环境变量动不了它，要改只能写进下面那个外挂配置（口径见部署指南 §11.4）
IM_ADMIN_SLOW_REQUEST_MILLIS=1000

# ===== 换域名后必须挂外挂配置（yml 里 im.cors.allowed-origins 是字面列表，没有 ${} 占位符，环境变量改不动它）=====
# 先在 app/extra/ 下由 example 生成 application-prod-extra.yml（bootstrap.sh 会自动做），再取消本行注释
# SPRING_CONFIG_ADDITIONAL_LOCATION=file:/app/extra/application-prod-extra.yml
SPRING_CONFIG_ADDITIONAL_LOCATION=file:/app/extra/application-prod-extra.yml
MANAGEMENT_HEALTH_MAIL_ENABLED=false
