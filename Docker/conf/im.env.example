# ==============================================================================
# 应用层环境变量：由 docker-compose.yml 的 env_file 注入 im-server 容器里的 java 进程，
# 对应 im-bootstrap/src/main/resources/application.yml 里那 60 个 ${ENV:默认值} 占位符。
#
# ★ 三条写这个文件的规矩（Docker部署指南.md 3.3，都是踩过的坑）：
#   ① 值不要加引号、不要写行内注释、不要指望 ${} 展开。
#      `IM_FILE_DIR=/app/files   # 注释` 会把「   # 注释」一起当成值传进进程，
#      路径类变量于是指向一个不存在的目录，而 Java 只报「找不到路径」不报「配置读错」。
#   ② 容器里的 127.0.0.1 指的是「它自己」：MYSQL_HOST / REDIS_HOST / MINIO_ENDPOINT 必须是服务名。
#   ③ 写完用 `docker compose exec im-server env | grep -E 'IM_|MYSQL_|REDIS_|MINIO_'` 复核真值。
#
# 用法：cp conf/im.env.example conf/im.env && chmod 600 conf/im.env && 把所有 <...> 换成真值
# （scripts/bootstrap.sh 会拒绝启动还留着 <...> 占位符的文件）
# ==============================================================================

# ===== 必填 =====
# dev profile 会在响应里回显验证码明文
SPRING_PROFILES_ACTIVE=prod
# ★ 裸机是 127.0.0.1，容器里必须是服务名（compose 网络内的 DNS 名）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=im_db
MYSQL_USER=im
# 与 .env 的 MYSQL_PASSWORD 逐字一致
MYSQL_PASSWORD=<与.env同一个>
# ★ 同上，必须是服务名
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<与.env同一个>
REDIS_DATABASE=0
# Sa-Token JWT 签名密钥：换掉内置那串 dev-only 默认值，否则任何人能自签 token
IM_JWT_SECRET=<换掉内置开发用长串>
# WS 连接票据 / 文件访问票据签名密钥，同上
IM_TICKET_SECRET=<换掉内置开发用长串>
# ★ 默认 D:/rizi1/IM（Windows 路径）。Linux 上不改不会报错，只会「日志静默丢失」——logback 不拦启动
IM_LOG_HOME=/app/logs
# ★ 默认 ${user.home}/im-upload-tmp，不在卷上就会被重建容器时清掉（大文件合并前分片落在这儿）
IM_UPLOAD_TMP_DIR=/app/upload-tmp
# 与 MySQL 容器的 --default-time-zone=+08:00 一起设，两边只设一个就会出现两种时钟
TZ=Asia/Shanghai

# ===== 文件存储：装 MinIO（默认，推荐）=====
IM_FILE_STORAGE=minio
# ★ 裸机 http://127.0.0.1:9000
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=<同.env的MINIO_ROOT_USER>
MINIO_SECRET_KEY=<同.env的MINIO_ROOT_PASSWORD>
# 桶名走 S3 规范：≥3 字符、只允许小写字母/数字/点/连字符。填 im 会被 SDK 拒绝并让后端启动失败
MINIO_BUCKET=im-files

# 不想跑 MinIO 就整段换成下面两行（少一个容器，代价是文件绑在这台机器的卷上）
# IM_FILE_STORAGE=local
# IM_FILE_DIR=/app/files

# ===== 按需（不设就留在开发默认值上，标 ★ 的那几条会「静默不可用」）=====
# ★ 默认 D:/资料/知识库/面试官：Linux 上这个路径不存在也不报错，只是检索永远空转
IM_AI_KNOWLEDGE_DIR=/app/knowledge
# 不设只有面试相关功能回「未配置」，其余照常
ALI_BABA_API_KEY=<百炼Key，可留空>
# ★ 默认 mock：只写日志、不发真短信，用户永远收不到验证码
IM_SMS_PROVIDER=aliyun
MAIL_USERNAME=<发件邮箱>
MAIL_PASSWORD=<SMTP授权码，不是登录密码>

# ===== 直播（不开直播整段注释掉即可）=====
IM_LIVE_ENABLED=true
# ★ yml 默认 /hls 是给本地 live-media-server.js 用的；生产约定 /live，且必须与 nginx 的 location 同名
IM_LIVE_PLAY_BASE_URL=/live
# ★★ 前缀必须与上面的 /live 一致；且绝不能写 http://nginx:8088/... ——那是容器内部 DNS，主播端在公网解析不到
IM_LIVE_PUSH_BASE_URL=http://<公网IP或域名>:8088/live
# 与 nginx/conf.d/im.conf 里 secure_link_md5 的 secret 逐字一致，不一致＝观众端一律 403 黑屏
IM_LIVE_SIGN_SECRET=<与nginx逐字一致>
# 与 live-retention sidecar 的 --days / IM_LIVE_REPLAY_RETENTION_DAYS 同一个数
IM_LIVE_REPLAY_RETENTION_DAYS=1

# ===== 通话 / TURN（只有公网跨 NAT 才需要，配合 coturn 那段 service）=====
IM_CALL_STUN_URLS=stun=<公网IP>:3478
IM_CALL_TURN_ENABLED=true
IM_CALL_TURN_URLS=turn=<公网IP>:3478?transport=udp
# 与 coturn 的 --static-auth-secret 逐字一致
IM_TURN_SECRET=<与coturn逐字一致>

# ===== 远控 UDP 打洞（默认关）=====
# 打开要同时做三件事：compose 里发布 "8947:8947/udp"、这里填公网 IP（不能写服务名）
IM_DIRECT_ENABLED=false
IM_DIRECT_PUNCH_HOST=

# ===== 监控 =====
# ★ 容器里的 loopback 只有本容器能到：宿主机 curl localhost:8081 即使发布了端口也是拒的。
#   外部 Prometheus 要抓就改 0.0.0.0 并且仍然不发布端口（同 compose 网络内可抓，公网碰不到）
MANAGEMENT_ADDRESS=127.0.0.1

# ===== 换域名后必须挂外挂配置（yml 里 im.cors.allowed-origins 是字面列表，没有 ${} 占位符，环境变量改不动它）=====
# 先在 app/extra/ 下由 example 生成 application-prod-extra.yml（bootstrap.sh 会自动做），再取消本行注释
# SPRING_CONFIG_ADDITIONAL_LOCATION=file:/app/extra/application-prod-extra.yml
