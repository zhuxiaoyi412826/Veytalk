#!/bin/bash
# STUB groupadd：--system --gid G NAME
D="${ST:?}"
f="$D/etc/group"
gid=""
name=""
prev=""
for a in "$@"; do
  [ "$prev" = "--gid" ] && { gid="$a"; prev=""; continue; }
  case "$a" in
    --system|--non-unique) ;;
    --gid) prev="--gid" ;;
    -*) ;;
    *) name="$a" ;;
  esac
done
[ -n "$gid" ] && { awk -F: -v g="$gid" '$3==g{exit 1}' "$f" || { echo "groupadd: GID '$gid' already in use" >&2; exit 4; }; }
grep -q "^$name:" "$f" && { echo "groupadd: group '$name' already exists" >&2; exit 9; }
echo "$name:x:${gid:-999}:" >> "$f"
exit 0
