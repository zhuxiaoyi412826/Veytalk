#!/bin/bash
# STUB useradd：--system --uid U --gid G --home-dir H NAME（真实里 --gid 给的是数字，必须已有该 gid 的组）
D="${ST:?}"
pf="$D/etc/passwd"; gf="$D/etc/group"
uid=""; gid=""; name=""; prev=""
for a in "$@"; do
  [ "$prev" = "--uid" ] && { uid="$a"; prev=""; continue; }
  [ "$prev" = "--gid" ] && { gid="$a"; prev=""; continue; }
  [ "$prev" = "--home-dir" ] && { prev=""; continue; }
  case "$a" in
    --system) ;;
    --uid) prev="--uid" ;;
    --gid) prev="--gid" ;;
    --home-dir|--create-home|--shell|-s) prev="" ;;
    -*) ;;
    *) name="$a" ;;
  esac
done
[ -n "$uid" ] && { awk -F: -v u="$uid" '$3==u{exit 1}' "$pf" || { echo "useradd: UID $uid is not unique" >&2; exit 4; }; }
grep -q "^$name:" "$pf" && { echo "useradd: user '$name' already exists" >&2; exit 9; }
# --gid 数字必须存在对应组，否则 useradd 报 invalid group
[ -n "$gid" ] && { awk -F: -v g="$gid" '$3==g{found=1} END{exit found?0:1}' "$gf" || { echo "useradd: invalid group '$gid'" >&2; exit 6; }; }
echo "$name:x:${uid:-1001}:${gid:-1001}::/app:/usr/sbin/nologin" >> "$pf"
exit 0
