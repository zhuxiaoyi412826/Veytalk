#!/bin/bash
# STUB getent：支持 `getent group KEY` 与 `getent passwd KEY`，KEY 可为数字或名字
D="${ST:?}"
db="$1"
key="$2"
case "$db" in
  group)  f="$D/etc/group";  fld=1 ;;  # 数字匹配第3字段 gid
  passwd) f="$D/etc/passwd"; fld=2 ;;  # 数字匹配第3字段 uid
  *) exit 2 ;;
esac
[ -f "$f" ] || exit 1
case "$key" in
  ''|*[!0-9]*)
    grep "^$key:" "$f" ;;
  *)
    awk -F: -v g="$key" '$3==g{print;found=1} END{exit found?0:1}' "$f" ;;
esac
